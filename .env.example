# Copy this file to .env and fill in your own values
OPENAI_API_KEY=your-openai-api-key
DATABASE_URL=postgresql://postgres:your-password@localhost:5432/hisab_kitab

# Testing (test/HK_Testing.py) — alag database, naam mein 'test' zaroori
TEST_DATABASE_URL=postgresql://postgres:your-password@localhost:5432/hisab_test

# Optional: LangSmith tracing
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=your-langsmith-api-key
LANGCHAIN_PROJECT=hisab-kitab

# Argument extraction ka prompt bundle ke hisaab se kaato (1 = chalu, 0 = poora purana prompt)
SLICED_PROMPT=0
